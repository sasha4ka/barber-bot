{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run api",
            "type": "shell",
            "command": "APP_MODE=api ~/.local/bin/poetry run uvicorn book_bot.api_entrypoint:app --port 9000 --app-dir src/"
        },
        {
            "label": "run bot",
            "type": "shell",
            "command": "APP_MODE=bot ~/.local/bin/poetry run uvicorn book_bot.bot_entrypoint:app --port 8000 --app-dir src/"
        }
    ]
}